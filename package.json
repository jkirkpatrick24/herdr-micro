{
  "name": "herdr-micro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ambient agent-status surface for herdr on a Work Louder Creator Micro 2 Pro",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
