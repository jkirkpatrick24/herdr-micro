{
  "name": "herdr-micro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ambient agent-status surface for herdr on a Work Louder Creator Micro 2 Pro",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "node-hid": "^3.4.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
